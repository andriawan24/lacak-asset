<idea-plugin>
    <id>id.andriawan.lacak-asset</id>
    <name>Lacak Asset</name>
    <vendor url="https://github.com/andriawan24">andriawan24</vendor>
    <idea-version since-build="242"/>

    <description><![CDATA[
        Detect similar and duplicate drawable resources in Android projects.
        Compares images across formats (PNG, JPG, WebP, SVG, Android XML vector)
        using perceptual hashing to find duplicates with a configurable similarity threshold.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <resource-bundle>messages.MyMessageBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="Lacak Asset"
                    anchor="bottom"
                    factoryClass="id.andriawan.lacakasset.toolwindow.DuplicateDrawableToolWindowFactory"
                    icon="/META-INF/pluginIcon.svg"/>

        <notificationGroup id="Lacak Asset" displayType="BALLOON"/>

        <projectConfigurable
                parentId="tools"
                instance="id.andriawan.lacakasset.settings.DrawableAnalyzerConfigurable"
                id="id.andriawan.lacakasset.settings"
                key="configurable.id.andriawan.lacakasset.settings.displayName"
                bundle="messages.MyMessageBundle"
                nonDefaultProject="true"/>

        <vfs.asyncListener
                implementation="id.andriawan.lacakasset.listener.DrawableFileChangeListener"/>
    </extensions>

    <actions>
        <group id="LacakAsset.Group" text="Lacak Asset" popup="true">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <action id="LacakAsset.Scan"
                    class="id.andriawan.lacakasset.action.ScanDrawablesAction"
                    text="Scan All Drawables"
                    icon="AllIcons.Actions.Find"/>

            <action id="LacakAsset.CompareAsset"
                    class="id.andriawan.lacakasset.action.CompareAssetAction"
                    text="Check Similar Drawable"
                    icon="AllIcons.Actions.Diff"/>
        </group>

        <action id="LacakAsset.FindSimilarDrawable"
                class="id.andriawan.lacakasset.action.FindSimilarDrawableAction"
                icon="AllIcons.Actions.Find">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
